{
  "name": "sisbanda-agent",
  "version": "1.0.0",
  "description": "SISBANDA Agent – Automação local da Polícia Civil da Paraíba",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev":   "electron . --dev",
    "build": "electron-builder --win --x64",
    "server-only": "node src/server.js"
  },
  "dependencies": {
    "cors":          "^2.8.5",
    "express":       "^4.18.2",
    "jsonwebtoken":  "^9.0.2",
    "playwright":    "^1.44.0",
    "winston":       "^3.13.0",
    "ws":            "^8.17.0"
  },
  "devDependencies": {
    "electron":         "^30.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "br.gov.pc.sisbanda.agent",
    "productName": "SISBANDA Agent",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/playwright/.local-chromium/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright/.local-chromium",
        "to":   "chromium",
        "filter": ["**/*"]
      }
    ]
  }
}
