{
  "name": "sisbanda-agent",
  "version": "1.1.0",
  "description": "SISBANDA Agent – Automação local da Polícia Civil da Paraíba",
  "author": "Banda de Música da Polícia Civil da Paraíba",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "server-only": "node src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "playwright": "^1.44.0",
    "winston": "^3.13.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "br.gov.pc.sisbanda.agent",
    "productName": "SISBANDA Agent",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "SisbandaAgentSetup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "include": "installer/nsis-extra.nsh"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
